<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings shared by every CHDmodern Visual Studio project (hand-written;
  the .vcxproj/.sln files next to it are generated by tools/gen-msvc.py).

  Properties a host solution may set.  The easiest way is a file called
  CHDmodern.settings.props placed NEXT TO the CHDmodern checkout (e.g.
  ext/CHDmodern.settings.props when the repo is in ext/CHDmodern); it is
  imported automatically.  Directory.Build.props or msbuild /p:... work too.

    ChdModernStaticCRT     true   = link the CRT statically (/MT, /MTd);
                                    must match the host, or the link fails
                                    with LNK2038 "mismatch detected for
                                    'RuntimeLibrary'".  Default: false (/MD).
    ChdModernBundledZlib   false  = don't build the bundled zlib; the host
                                    links its own.  Then set
                                    ChdModernZlibInclude to its include dir.
    ChdModernBundledZstd   false  = same for zstd (ChdModernZstdInclude).
    ChdModernDllLinkLibs   extra .lib files the DLL (chdmodern_dll) links,
                           e.g. the host's zlib/zstd when the bundled ones
                           are switched off.  Default: empty.
    ChdModernOutDir        where .lib/.exe files go
                           (default: <repo>\build\msvc\<Platform>\<Configuration>\)
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)..\..\CHDmodern.settings.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\CHDmodern.settings.props')" />

  <PropertyGroup>
    <ChdModernRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</ChdModernRoot>

    <ChdModernStaticCRT Condition="'$(ChdModernStaticCRT)' == ''">false</ChdModernStaticCRT>
    <ChdModernBundledZlib Condition="'$(ChdModernBundledZlib)' == ''">true</ChdModernBundledZlib>
    <ChdModernBundledZstd Condition="'$(ChdModernBundledZstd)' == ''">true</ChdModernBundledZstd>
    <ChdModernZlibInclude Condition="'$(ChdModernZlibInclude)' == ''">$(ChdModernRoot)third_party\zlib</ChdModernZlibInclude>
    <ChdModernZstdInclude Condition="'$(ChdModernZstdInclude)' == ''">$(ChdModernRoot)third_party\zstd\lib</ChdModernZstdInclude>

    <ChdModernDllLinkLibs Condition="'$(ChdModernDllLinkLibs)' == ''"></ChdModernDllLinkLibs>
    <ChdModernOutDir Condition="'$(ChdModernOutDir)' == ''">$(ChdModernRoot)build\msvc\$(Platform)\$(Configuration)\</ChdModernOutDir>
    <OutDir>$(ChdModernOutDir)</OutDir>
    <IntDir>$(ChdModernRoot)build\msvc\obj\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>

    <!-- what code using MAME's headers (chdmodern itself, the self-test) needs -->
    <ChdModernDefines>ZLIB_CONST;LSB_FIRST;CRLF=3;FLAC__NO_DLL;Z7_ST;WIN32_LEAN_AND_MEAN;NOMINMAX;_CRT_SECURE_NO_DEPRECATE;_CRT_NONSTDC_NO_DEPRECATE</ChdModernDefines>
    <ChdModernIncludes>$(ChdModernRoot)include;$(ChdModernRoot)src\mame\util;$(ChdModernRoot)src\mame\osd;$(ChdModernRoot)third_party;$(ChdModernZlibInclude);$(ChdModernZstdInclude);$(ChdModernRoot)third_party\flac\include</ChdModernIncludes>

    <!-- same options MAME uses for its own MSVC builds -->
    <ChdModernCppOptions>/utf-8 /bigobj /Zc:__cplusplus /Zc:preprocessor /permissive-</ChdModernCppOptions>
    <ChdModernCOptions>/utf-8</ChdModernCOptions>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <!-- MAME's own MSVC build silences the same set -->
      <DisableSpecificWarnings>4018;4100;4127;4146;4244;4245;4250;4267;4305;4324;4334;4389;4456;4457;4458;4459;4701;4702;4996;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <PreprocessorDefinitions>WIN32;_WIN32;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(ChdModernStaticCRT)' == 'true'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(ChdModernStaticCRT)' != 'true'">MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(ChdModernStaticCRT)' == 'true'">MultiThreaded</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(ChdModernStaticCRT)' != 'true'">MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
</Project>
